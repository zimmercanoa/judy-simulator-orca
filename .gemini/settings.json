{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.85", "--headless", "--isolated"],
      "timeout": 60000
    },
    "github": {
      "httpUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer $GITHUB_PERSONAL_ACCESS_TOKEN",
        "X-MCP-Toolsets": "repos,pull_requests,actions,issues",
        "X-MCP-Readonly": "true"
      },
      "timeout": 30000
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.6.0"],
      "timeout": 60000
    }
  }
}
