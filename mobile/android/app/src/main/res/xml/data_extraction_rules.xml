<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: excluye TODO de la copia en la nube y de la transferencia
  entre dispositivos. El token de sesión (flutter_secure_storage) está
  cifrado con una clave del Keystore que no se puede restaurar en otro
  equipo; copiarlo solo provocaría errores de descifrado.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
